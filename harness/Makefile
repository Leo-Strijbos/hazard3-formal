IBEX_ROOT=../..

SAIL=$(shell which sail)
PSGEN=$(shell which psgen)

# GATE 6: THE SAIL MODEL IS A LOCAL FORK, NOT THE NIX-STORE COPY.
#
# sail-riscv-h3/ is a git repository pinned to lowrisc/sail-riscv 81a266b6
# (branch `ibex`) -- byte-identical to $LOWRISC_SAIL_RISCV_SRC, which is the
# revision ibex's flake.lock pins -- plus one commit carrying the two
# specification-configuration fixes of gate 6.  `git -C sail-riscv-h3 diff
# HEAD~1` is the patch; spec/sail-riscv-h3.patch is a copy of it.
#
# Ibex's dv/formal/README.md documents LOWRISC_SAIL_RISCV_SRC as an overridable
# path for exactly this.  Overridden here rather than in the environment so
# that a plain `make` cannot silently pick up the unpatched model.
LOWRISC_SAIL_RISCV_SRC := $(CURDIR)/sail-riscv-h3
SAIL_RISCV_MODEL_DIR=${LOWRISC_SAIL_RISCV_SRC}/model

include sail-sources.mk

PSGEN_SRCS=thm/btype.proof thm/ibex.proof thm/mem.proof thm/riscv.proof
PSGEN_FLAGS=-root riscv -task

SAIL_EXTRA_SRCS=spec/main.sail

# -sv, use the SystemVerilog backend
# --sv-comb, generate a always_comb instead of an initial block
# --sv-inregs --sv-outregs, produce inputs and outputs for every Sail register
# --sv-nostrings, --sv-nopacked, --sv-nomem, avoid generating some things Jasper doesn't like (FIXME: --sv-nopacked might be better removed?)
# -Oconstrant_fold, do basic optimisation
# -memo-z3, resolving types requires a sat solver, this helps speed up those queries
# --sv-unreachable, remove the implementations of functions to either make the design smaller or avoid recursion loops (FIXME: Still necessary?)
# --sv-fun2wires (n:)?f, transform a function into ports, with n (or 1) slots
SAIL_SV_FLAGS=-sv --sv-comb --sv-inregs --sv-outregs --sv-nostrings --sv-nopacked --sv-nomem -Oconstant_fold -memo-z3 \
	--sv-unreachable translate --sv-unreachable lookup_TLB --sv-unreachable translate_tlb_miss --sv-unreachable translate_tlb_hit --sv-unreachable pt_walk \
	--sv-fun2wires 2:read_ram \
	--sv-fun2wires 2:write_ram \
	--sv-fun2wires wX

# Use fusesoc to resolve the tree of components, copy all resolved source files into the build/ directory,
# and then generate a filelist for jasper to ingest.
# - Note. we use the 'vcs' fusesoc backend flow to generate the filelist. This is because fusesoc does not currently implement a
#   JasperGold backend, but this is not an issue as the file-format generated by the vcs flow is compatible with both jasper and
#   yosys-slang.
build/fusesoc: $(IBEX_ROOT)/rtl $(IBEX_ROOT)/vendor
	mkdir -p build/fusesoc
	fusesoc \
	  --cores-root $(IBEX_ROOT) \
	  run \
	  --build-root build/fusesoc \
	  --tool vcs \
	  --setup \
	  lowrisc:ibex:ibex_formal:0.1
	touch build/fusesoc # Fix timestamps for Makefile

# The sail spec module, constructed from LOWRISC_SAIL_RISCV_SRC, compiled by our fork of the sail compiler
build/ibexspec.sv: $(SAIL) $(SAIL_SRCS) $(SAIL_EXTRA_SRCS) sail-sources.mk Makefile spec/fix_bugs.py
	mkdir -p build
	cd build && $(SAIL) $(SAIL_SRCS) $(addprefix ../,$(SAIL_EXTRA_SRCS)) $(SAIL_SV_FLAGS) $(addprefix -sv_unreachable execute_,$(COMPRESSED_INSTRS)) -o ibexspec
	python3 spec/fix_bugs.py

# The compiled property structure, and the associated TCL
build/psgen-jg.sv: $(PSGEN) $(PSGEN_SRCS) Makefile
	mkdir -p build
	$(PSGEN) $(addprefix -path ,$(PSGEN_SRCS)) $(PSGEN_FLAGS) -sv-out build/psgen-jg.sv -tcl-out build/psgen.tcl

# Same as above, but generate our own covers, and tweak for consumption by our tools
build/psgen-yosys.sv: $(PSGEN) $(PSGEN_SRCS) Makefile
	mkdir -p build
	$(PSGEN) $(addprefix -path ,$(PSGEN_SRCS)) $(PSGEN_FLAGS) -sv-out build/psgen-yosys.sv -clocking -covers -cover-assert -step-prefix

# The aiger file for the *Ibex* OSS flow (kept for reference; the Hazard3 port
# below is what `make build/all.aig` now builds). The main yosys script is in build_all.ys
build/ibex-all.aig: build/psgen-yosys.sv build/fusesoc build/ibexspec.sv check build_all.ys $(LOWRISC_YOSYS_SLANG) build/yosys_formal.so
	yosys -m $(LOWRISC_YOSYS_SLANG) -m build/yosys_formal.so -v 1 -s <(cat ./build_all.ys | sed "s|LOWRISC_SAIL_SRC|$(LOWRISC_SAIL_SRC)|g")

################################################################################
# Hazard3 port (bring-up skeleton) -- see BRINGUP.md
################################################################################

HAZARD3_ROOT ?= /opt/verif/hazard3

# Hazard3's own AHB-Lite slave assumptions, instantiated verbatim by
# check/h3_core_common.svh. Override to point at a deliberately broken copy
# (the gate-1 negative control):
#   make AHBL_SLAVE_ASSUMPTIONS=$(CURDIR)/build/broken/ahbl_slave_assumptions.v ...
AHBL_SLAVE_ASSUMPTIONS ?= $(HAZARD3_ROOT)/test/formal/common/ahbl_slave_assumptions.v

# Core + environment sources shared by build/all.aig and build/core.aig.
H3_HARNESS_SRCS=check/h3_core_common.svh check/peek/h3_abs.svh check/peek/h3_commit.svh check/peek/h3_mem.svh check/peek/h3_follower.svh check/peek/h3_goals.svh check/peek/h3_spike.svh check/peek/h3_cti_round1.svh check/peek/h3_cti_round2.svh check/peek/h3_cti_round3.svh check/peek/h3_cti_round3b.svh check/peek/h3_cti_round4.svh check/peek/h3_cti_round5.svh check/peek/h3_cti_round6.svh check/peek/h3_cti_round7.svh check/peek/h3_cti_round8.svh check/peek/h3_cti_round9.svh check/peek/h3_cti_round10.svh check/peek/h3_cti_round11.svh check/peek/h3_cti_round12.svh check/peek/h3_cti_round13.svh check/peek/h3_cti_round14.svh check/peek/h3_cti_round15.svh check/h3_ahbl_master_props.sv $(AHBL_SLAVE_ASSUMPTIONS)

# Proof sources for the Hazard3 flow. Currently just the two bring-up properties.
PSGEN_H3_SRCS=thm/hazard3.proof
PSGEN_H3_FLAGS=-root hazard3 -task

# Local, patched copy of the Hazard3 RTL. This is the analogue of the Ibex
# flow's `make fusesoc` step: copy the RTL into build/ and patch it there so
# the upstream tree is left untouched. See patch_hazard3_rtl.sh for the patches.
build/hazard3-rtl: $(wildcard $(HAZARD3_ROOT)/hdl/*.v $(HAZARD3_ROOT)/hdl/*.vh $(HAZARD3_ROOT)/hdl/arith/*.v) patch_hazard3_rtl.sh
	rm -rf build/hazard3-rtl
	mkdir -p build
	cp -r $(HAZARD3_ROOT)/hdl build/hazard3-rtl
	./patch_hazard3_rtl.sh build/hazard3-rtl
	touch build/hazard3-rtl # Fix timestamps for Makefile

# Hazard3 has no fusesoc description, so the filelist is derived directly from
# hdl/hazard3.f (lines of the form "file <path relative to hdl/>"). The 2-port
# CPU wrapper is dropped: the target configuration is hazard3_cpu_1port.
build/hazard3.scr: build/hazard3-rtl $(HAZARD3_ROOT)/hdl/hazard3.f Makefile
	mkdir -p build
	sed -n 's|^file |$(CURDIR)/build/hazard3-rtl/|p' $(HAZARD3_ROOT)/hdl/hazard3.f | grep -v hazard3_cpu_2port > $@

# The compiled property structure for the Hazard3 proofs
build/psgen-h3.sv: $(PSGEN) $(PSGEN_H3_SRCS) Makefile
	mkdir -p build
	$(PSGEN) $(addprefix -path ,$(PSGEN_H3_SRCS)) $(PSGEN_H3_FLAGS) -sv-out build/psgen-h3.sv -clocking -covers -cover-assert -step-prefix

# Substitute the environment-dependent paths into the yosys scripts. Done as
# real files (rather than the Ibex flow's process substitution) so that the
# rules work whether or not make's shell is bash.
build/build_h3_spec.ys: build_h3_spec.ys Makefile
	mkdir -p build
	sed -e "s|LOWRISC_SAIL_SRC|$(LOWRISC_SAIL_SRC)|g" $< > $@

build/build_h3_fast.ys: build_h3_fast.ys Makefile
	mkdir -p build
	sed -e "s|LOWRISC_SAIL_SRC|$(LOWRISC_SAIL_SRC)|g" -e "s|HAZARD3_RTL|$(CURDIR)/build/hazard3-rtl|g" -e "s|AHBL_SLAVE_ASSUMPTIONS_V|$(AHBL_SLAVE_ASSUMPTIONS)|g" $< > $@

# STAGE B for the core-only model. Same substitutions, no Sail include path.
build/build_h3_core.ys: build_h3_core.ys Makefile
	mkdir -p build
	sed -e "s|HAZARD3_RTL|$(CURDIR)/build/hazard3-rtl|g" -e "s|AHBL_SLAVE_ASSUMPTIONS_V|$(AHBL_SLAVE_ASSUMPTIONS)|g" $< > $@

# spec/spec_api.sv truncated just after its port list, plus `endmodule`: an
# empty module with the *real* interface (parameters, enum types, unpacked
# array ports).  yosys-slang's --empty-blackboxes turns it into a blackbox, so
# stage B type-checks check/h3_top.sv's instantiation without elaborating the
# 1.5 MB Sail model behind it.
build/spec_api_bb.sv: spec/spec_api.sv Makefile
	mkdir -p build
	sed -n '1,/^);/p' $< > $@
	echo 'endmodule' >> $@

# STAGE A -- the cached, lowered Sail specification.  ~8 min, and rebuilt only
# when the specification itself changes, which it does not during harness work.
build/spec.il: build/ibexspec.sv spec/spec_api.sv spec/stub.sv build/build_h3_spec.ys $(LOWRISC_YOSYS_SLANG) build/yosys_formal.so
	yosys -m $(LOWRISC_YOSYS_SLANG) -m build/yosys_formal.so -v 1 -s build/build_h3_spec.ys

# STAGE B -- the core aiger file: Hazard3 + the (cached) Sail reference model +
# the psgen properties.  This is what a harness-only edit re-runs.
build/all.aig: build/psgen-h3.sv build/hazard3.scr build/hazard3-rtl build/ibexspec.sv build/spec_api_bb.sv build/spec.il check/h3_top.sv $(H3_HARNESS_SRCS) build/build_h3_fast.ys $(LOWRISC_YOSYS_SLANG) build/yosys_formal.so
	yosys -m $(LOWRISC_YOSYS_SLANG) -m build/yosys_formal.so -v 1 -s build/build_h3_fast.ys
	python3 fix_ywmap.py build/all.ywmap

# MODEL A -- core + bus environment, no Sail specification. Same core, same
# environment (check/h3_core_common.svh is shared with check/h3_top.sv), same
# psgen property set; only the spec instance is absent. See BRINGUP.md.
build/core.aig: build/psgen-h3.sv build/hazard3.scr build/hazard3-rtl check/h3_core_top.sv $(H3_HARNESS_SRCS) build/build_h3_core.ys $(LOWRISC_YOSYS_SLANG) build/yosys_formal.so
	yosys -m $(LOWRISC_YOSYS_SLANG) -m build/yosys_formal.so -v 1 -s build/build_h3_core.ys

.PHONY: core
core: build/core.aig

# Soundness check for the two-model split: the set of exposed signal names under
# the core and its bus environment must be identical in the two models.
.PHONY: check-env
check-env: build/all.vmap build/core.vmap
	./check_env.sh

# The original single-invocation build, writing build/mono-all.* instead of
# build/all.*.  It is the equivalence reference for the split build above, and
# the way to get a .smt2 (which the split build does not write -- nothing in
# conductor.py actually consumes build/all.smt2).
build/build_h3_mono.ys: build_h3.ys Makefile
	mkdir -p build
	sed -e "s|LOWRISC_SAIL_SRC|$(LOWRISC_SAIL_SRC)|g" -e "s|HAZARD3_RTL|$(CURDIR)/build/hazard3-rtl|g" -e "s|AHBL_SLAVE_ASSUMPTIONS_V|$(AHBL_SLAVE_ASSUMPTIONS)|g" -e "s|build/all\.|build/mono-all.|g" $< > $@

build/mono-all.aig: build/psgen-h3.sv build/hazard3.scr build/hazard3-rtl build/ibexspec.sv check/h3_top.sv $(H3_HARNESS_SRCS) build/build_h3_mono.ys $(LOWRISC_YOSYS_SLANG) build/yosys_formal.so
	yosys -m $(LOWRISC_YOSYS_SLANG) -m build/yosys_formal.so -v 1 -s build/build_h3_mono.ys
	python3 fix_ywmap.py build/mono-all.ywmap

.PHONY: mono
mono: build/mono-all.aig

# Build the custom yosys plugins
build/yosys_formal.so: yosys_formal/global_clock.cc yosys_formal/write_aiger.cc yosys_formal/opt_muxtree.cc
	yosys-config --build build/yosys_formal.so yosys_formal/global_clock.cc yosys_formal/write_aiger.cc yosys_formal/opt_muxtree.cc

# Build the aig-manip Rust tool
build/aig-manip: aig-manip/src/main.rs
	mkdir -p build
	cd aig-manip && cargo build --release
	cp aig-manip/target/release/aig-manip build/

# Run the jasper environment in interactive mode
.PHONY: jg
jg: build/fusesoc build/psgen-jg.sv build/ibexspec.sv
	jg verify.tcl -allow_unsupported_OS -acquire_proj

# Jasper environment for regression and unattended runs
.PHONY: all
all: build/fusesoc build/psgen-jg.sv build/ibexspec.sv
	jg verify.tcl -allow_unsupported_OS -acquire_proj -no_gui --- "prove_no_liveness"

################################################################################

.PHONY: clean
clean:
	rm -rf build/ aig-manip/target
	rm -rf jgproject/ jgproofs/

