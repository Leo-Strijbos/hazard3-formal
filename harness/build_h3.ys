# Hazard3 bring-up: parse and lower the Hazard3 RTL + the Sail specification.
# The sail library include path and the Hazard3 RTL path are substituted by the Makefile.

read_slang --no-implicit-memories --top top -DSYNTHESIS -DYOSYS -DHAZARD3_RVFI_STANDALONE \
	build/ibexspec.sv spec/stub.sv spec/spec_api.sv check/h3_ahbl_master_props.sv AHBL_SLAVE_ASSUMPTIONS_V check/h3_top.sv \
	-F build/hazard3.scr \
	-I LOWRISC_SAIL_SRC/lib/sv/ -I HAZARD3_RTL \
	--single-unit --no-proc
setattr -set keep 1 n:\\*
proc
global_clk \clk_i
opt_muxtree_2
opt_clean

memory_nordff
delete */t:$print
script h3_tieoff_undriven.ys
setundef -undriven -anyseq
memory_map -formal
delete -output
expose n:\\*

opt_muxtree_2
opt_expr
opt_dff
opt_clean
techmap
simplemap
dffunmap
opt_clean
write_smt2 build/all.smt2
aigmap
write_aiger_2 -I -B -zinit -no-startoffset -ywmap build/all.ywmap -vmap build/all.vmap build/all.aig
