diff --git a/model/riscv_sys_regs.sail b/model/riscv_sys_regs.sail
index 27c3e3c..7357d8d 100644
--- a/model/riscv_sys_regs.sail
+++ b/model/riscv_sys_regs.sail
@@ -107,6 +107,21 @@ val sys_pmp_max_count = {c: "sys_pmp_max_count", ocaml: "Platform.pmp_max_count"
 /* whether misa.v was enabled at boot */
 val sys_enable_vext = {c: "sys_enable_vext", ocaml: "Platform.enable_vext", _: "sys_enable_vext"} : unit -> bool
 
+/* --- WARL policy configuration -------------------------------------------
+   mtvec and mcause are WARL registers.  The architecture does not fix which
+   of their bits an implementation must make writable, so a model that fixes
+   them describes ONE implementation rather than the architecture.  These two
+   hooks carry the implementation's writable-bit mask; bits they clear keep
+   their previous value, which is the WARL-legal behaviour for a field an
+   implementation does not implement.
+
+   BOTH DEFAULT TO ALL-ONES, and with all-ones legalize_tvec and
+   legalize_mcause below reduce EXACTLY to upstream riscv/sail-riscv.  A
+   platform that wants a narrower policy states it here rather than in the
+   body of the legalizer. */
+val sys_tvec_wmask = {c: "sys_tvec_wmask", ocaml: "Platform.tvec_wmask", _: "sys_tvec_wmask"} : unit -> xlenbits
+val sys_mcause_wmask = {c: "sys_mcause_wmask", ocaml: "Platform.mcause_wmask", _: "sys_mcause_wmask"} : unit -> xlenbits
+
 /* This function allows an extension to veto a write to Misa
    if it would violate an alignment restriction on
    unsetting C. If it returns true the write will have no effect. */
@@ -432,9 +447,31 @@ bitfield Mtvec : xlenbits = {
 }
 register mtvec : Mtvec  /* Trap Vector */
 
+/* mtvec is WARL.  RISC-V privileged spec v1.12 s3.1.7, "Machine Trap-Vector
+   Base-Address Register": "The mtvec register is an MXLEN-bit WARL read/write
+   register"; the BASE field "must always be aligned on a 4-byte boundary";
+   MODE encodings 0 (Direct) and 1 (Vectored) are defined and ">=2" is
+   Reserved.  An implementation is free to hardwire BASE bits (making its
+   effective alignment coarser than 4 bytes) and free to hardwire MODE.  All
+   of those are legal implementations of the same architecture, so the model
+   must be parameterised rather than fixed to one core's choice.
+
+   lowRISC replaced upstream's legalizer with `Mk_Mtvec(v[31..8] @ 0x01)`
+   -- 256-byte aligned BASE, MODE hardwired to Vectored -- which is Ibex's
+   policy and not the architecture's.  Restored to upstream, with the
+   writable-bit mask in front:
+
+     sys_tvec_wmask() == 0xFFFFFFFF  =>  bit-for-bit upstream riscv/sail-riscv.
+
+   The reserved-MODE arm is upstream's: the write is WARL-legalized by keeping
+   the previous MODE, which is one architecturally permitted response. */
 function legalize_tvec(o : Mtvec, v : xlenbits) -> Mtvec = {
- // 256 byte aligned, always vectored
- Mk_Mtvec(v[31..8] @ 0x01)
+ let v = Mk_Mtvec((v & sys_tvec_wmask()) | (o.bits & ~(sys_tvec_wmask())));
+ match (trapVectorMode_of_bits(v[Mode])) {
+   TV_Direct => v,
+   TV_Vector => v,
+   _         => [v with Mode = o[Mode]]
+ }
 }
 
 bitfield Mcause : xlenbits = {
@@ -443,13 +480,23 @@ bitfield Mcause : xlenbits = {
 }
 register mcause : Mcause
 
-function legalize_mcause(v : xlenbits) -> Mcause = {
-  // Ibex internal interrupts
-  if v[31..30] == 0b11 then
-    Mk_Mcause([v with 30..5 = sail_ones(26)])
-  else
-    Mk_Mcause([v with 30..5 = sail_zeros(26)])
-}
+/* mcause is WARL.  RISC-V privileged spec v1.12 s3.1.15, "Machine Cause
+   Register": "The Exception Code field ... is a WARL field, so it is not
+   guaranteed to hold the value of an illegal exception code", and s3.1.15
+   requires only that the register can represent the causes the implementation
+   can itself generate.  Hardwiring the upper Exception Code bits to zero is
+   therefore architecturally legal, and so is full writability.
+
+   UPSTREAM riscv/sail-riscv HAS NO LEGALIZER HERE AT ALL: riscv_insts_zicsr
+   writes `mcause.bits = value`.  lowRISC ADDED this function and put Ibex's
+   internal-interrupt encoding (smear bits 30..5 to all-ones when v[31:30] is
+   0b11, else to all-zeros) into it.  That encoding is Ibex's, not the
+   architecture's, so it is replaced by the writable-bit mask:
+
+     sys_mcause_wmask() == 0xFFFFFFFF  =>  the identity, i.e. exactly
+     upstream's `mcause.bits = value`. */
+function legalize_mcause(o : Mcause, v : xlenbits) -> Mcause =
+  Mk_Mcause((v & sys_mcause_wmask()) | (o.bits & ~(sys_mcause_wmask())))
 
 /* Interpreting the trap-vector address */
 function tvec_addr(m : Mtvec, c : Mcause) -> option(xlenbits) = {
