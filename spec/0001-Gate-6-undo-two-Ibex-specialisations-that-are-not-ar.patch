+    Ext_DataAddr_OK(paddr) =>
+      if   check_misaligned(paddr, width)
+      then { handle_mem_exception(paddr, E_Load_Addr_Align()); RETIRE_FAIL }
+      else match width_bytes {
       1 => match mem_read(Read(Data), paddr, 1, aq, rl, false) {
         MemValue(result) => { X(rd) = extend_value(is_unsigned, result); RETIRE_SUCCESS },
         MemException(addr, e) => { handle_mem_exception(addr, e); RETIRE_FAIL },
@@ -383,7 +395,12 @@ function clause execute (STORE(imm, rs2, rs1, width, aq, rl)) = {
      Some extensions perform additional checks on address validity. */
   match ext_data_get_addr(rs1, offset, Write(Data), width_bytes) {
     Ext_DataAddr_Error(e)  => { ext_handle_data_check_error(e); RETIRE_FAIL },
