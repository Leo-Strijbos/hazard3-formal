+++ b/model/riscv_insts_base.sail
@@ -326,7 +326,19 @@ function clause execute(LOAD(imm, rs1, rd, is_unsigned, width, aq, rl)) = {
      Some extensions perform additional checks on address validity. */
   match ext_data_get_addr(rs1, offset, Read(Data), width_bytes) {
     Ext_DataAddr_Error(e)  => { ext_handle_data_check_error(e); RETIRE_FAIL },
-    Ext_DataAddr_OK(paddr) => match width_bytes {
+    /* Misaligned-access support is OPTIONAL: RISC-V unprivileged spec v2.2
+       s2.6 ("Load and Store Instructions") -- "the misaligned load and store
+       instructions ... may raise a load or store address-misaligned exception"
+       -- so both trapping and splitting are architecturally legal, and which
+       one this model does is a PLATFORM PARAMETER, plat_enable_misaligned_access.
+       Upstream riscv/sail-riscv makes that call here; lowRISC's memory rework
+       (b63cba3c) deleted it along with translateAddr/mem_write_ea, leaving
