+      if   check_misaligned(paddr, width)
+      then { handle_mem_exception(paddr, E_SAMO_Addr_Align()); RETIRE_FAIL }
+      else {
       let rs2_val = X(rs2);
       match mem_write_value(paddr, width_bytes, rs2_val[width_bytes * 8 - 1 .. 0], aq, rl, false) {
         MemValue(true)  => RETIRE_SUCCESS,
